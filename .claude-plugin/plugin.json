{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "socrata-mcp-server",
  "version": "0.2.1",
  "description": "Search and query government open-data portals (Socrata SODA API) via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/socrata-mcp-server#readme",
  "repository": "https://github.com/cyanheads/socrata-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "socrata",
    "open-data",
    "soda-api",
    "government-data",
    "civic-data"
  ],
  "userConfig": {
    "SOCRATA_APP_TOKEN": {
      "type": "string",
      "title": "Socrata app token",
      "description": "Optional. App token for higher rate limits, free to register at any Socrata portal (e.g. data.seattle.gov/profile/app_tokens). Without one, requests share a throttled pool per IP.",
      "sensitive": true,
      "default": ""
    }
  },
  "mcpServers": {
    "socrata-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/socrata-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "SOCRATA_APP_TOKEN": "${user_config.SOCRATA_APP_TOKEN}",
        "SOCRATA_DEFAULT_DOMAIN": "data.seattle.gov"
      }
    }
  }
}
